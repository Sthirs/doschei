PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@doschei-postgres.doschei.svc.cluster.local:5432/doschei
JWT_SECRET=change-me-in-real-environments
DB_SYNC=true
SEED_ON_STARTUP=false
CORS_ORIGIN=http://doschei.127.0.0.1.nip.io

# OAuth — optional; leave unset to disable OAuth sign-in
# OAUTH_CONFIG is a JSON string matching the OAuth2/OIDC client config
OAUTH_CONFIG={"autoLaunch":false,"autoRegister":true,"buttonText":"Sign in with Dex","clientId":"doschei","clientSecret":"doschei-dev-secret","enabled":true,"issuerUrl":"http://doschei.192.168.49.2.nip.io/dex","scope":"openid email profile"}
OAUTH_STATE_SECRET=change-me-dev-state-secret
FRONTEND_URL=http://doschei.192.168.49.2.nip.io

# Rate limiting — global per-IP limiter on /api (health endpoint excluded).
# High limit locally so dev/e2e flows never trip it; production defaults
# come from Helm values (500 req / 5 min window).
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_LIMIT=1000000

# Session lifetimes (ADR-0023) — short-lived access JWT plus a rotating
# refresh-token cookie. The refresh window is SLIDING: every rotation resets it,
# so an active user never has to sign in again.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=7776000
# Replaying a just-rotated token inside this window is treated as a benign
# multi-tab race (401, family kept) rather than theft (401, whole family
# revoked). Short locally so the reuse-detection tests do not need a 31s sleep;
# production keeps the 30s Helm default.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=1
