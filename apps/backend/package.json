{
  "name": "@doschei/backend",
  "version": "0.1.9",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:integration": "bash ./scripts/test-integration.sh",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "concurrently": "10.0.3",
    "cors": "2.8.6",
    "cypress": "15.18.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.0.0",
    "@types/supertest": "7.2.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.4",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  }
