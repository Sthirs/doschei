{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>neteye-platform/repo-commons", ":semanticCommits", ":dependencyDashboard", "schedule:weekly"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates"
    },
    {
      "description": "Own app images: tags are set by the release workflow",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/sthirs/doschei/**"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "security updates",
    "schedule": ["at any time"]
  }
}
